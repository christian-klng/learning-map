DATABASE_URL=postgres://postgres:postgres@localhost:5433/learning_map
UPLOAD_DIR=./uploads

# Passwords for the on-screen mode toggle (students = edit, teacher = admin).
# Anything truthy works locally; use real secrets in production.
STUDENT_PASSWORD=changeme-student
ADMIN_PASSWORD=changeme-admin

# 32+ random chars used to HMAC-sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev-secret-replace-me-with-32-random-hex-chars
