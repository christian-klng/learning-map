{
  "name": "learning-map",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/lib/server/db/migrate.ts",
    "db:seed": "tsx --env-file=.env src/lib/server/db/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.2.12",
    "@sveltejs/kit": "^2.20.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.1",
    "svelte": "^5.20.0",
    "svelte-check": "^4.1.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "cytoscape": "^3.31.0",
    "cytoscape-fcose": "^2.2.0",
    "drizzle-orm": "^0.38.3",
    "marked": "^18.0.4",
    "pg": "^8.13.1"
  }
}
